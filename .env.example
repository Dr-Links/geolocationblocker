# ─────────────────────────────────────────────────────────────────────────────
# AI Social Media Manager — environment variables
# Copy to .env and fill in. Every external integration defaults to a MOCK when
# its credentials are blank, so the app runs end-to-end with only the
# "Required" section filled in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Postgres. docker-compose uses host "postgres"; local dev uses localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialai?schema=public
# Redis for BullMQ (scheduler + generation jobs).
REDIS_URL=redis://localhost:6379
# Auth.js secret. Generate: openssl rand -base64 32
AUTH_SECRET=
# Behind a proxy/container, Auth.js must trust the Host header.
AUTH_TRUST_HOST=true
# 32-byte base64 key for AES-256-GCM encryption of OAuth tokens + API keys at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Optional previous key during rotation (decrypt-only).
ENCRYPTION_KEY_PREVIOUS=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Seed (prisma/seed.ts) ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_PASSWORD=Demo12345!

# ── App sign-in OAuth (optional; button hidden when blank) ───────────────────
# These are for logging INTO the app, not for social publishing connections.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Storage: S3-compatible (Phase 3). Blank → local mock storage ─────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Stripe (Phase 2). Blank → billing runs in mock mode ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── AI providers — platform keys (Phase 3). Blank → MockGenerator ────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
HUGGINGFACE_API_TOKEN=

# ── Social publishing apps (Phase 4). Blank → MockPublisher ──────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
