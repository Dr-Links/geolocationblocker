# ─────────────────────────────────────────────────────────────────────────────
# AI Social Media Manager — environment variables
# Copy to .env and fill in. Every external integration defaults to a MOCK when
# its credentials are blank, so the app runs end-to-end with only the
# "Required" section filled in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Postgres. docker-compose uses host "postgres"; local dev uses localhost.
# DATABASE_URL: runtime role. MUST NOT be a superuser or have BYPASSRLS, otherwise
# row-level tenant isolation is silently skipped (the app refuses to start in production).
DATABASE_URL=postgresql://postpilot_app:postpilot_app@localhost:5432/socialai?schema=public
# DIRECT_DATABASE_URL: table-owner role, used only by `prisma migrate`.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialai?schema=public
# Redis for BullMQ (scheduler + generation jobs).
REDIS_URL=redis://localhost:6379
# Auth.js secret. Generate: openssl rand -base64 32
AUTH_SECRET=
# Behind a proxy/container, Auth.js must trust the Host header.
AUTH_TRUST_HOST=true
# 32-byte base64 key for AES-256-GCM encryption of OAuth tokens + API keys at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Optional previous key during rotation (decrypt-only).
ENCRYPTION_KEY_PREVIOUS=

# ── Email. Blank → ConsoleMailer (emails logged; invite links shown in UI) ──
EMAIL_FROM="Postpilot <no-reply@localhost>"

# ── Rate limiting (requests per window) ──────────────────────────────────────
RATE_LIMIT_LOGIN_PER_15M=10
RATE_LIMIT_SIGNUP_PER_HOUR=5

# ── Tests (vitest). Runtime role + owner role on a separate database ─────────
TEST_DATABASE_URL=postgresql://postpilot_app:postpilot_app@localhost:5432/socialai_test?schema=public
TEST_DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialai_test?schema=public

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Seed (prisma/seed.ts) ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_PASSWORD=Demo12345!

# ── App sign-in OAuth (optional; button hidden when blank) ───────────────────
# These are for logging INTO the app, not for social publishing connections.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Storage: S3-compatible. Blank → local files in STORAGE_LOCAL_DIR ─────────
# (app and worker must share this directory; docker-compose mounts a volume).
STORAGE_LOCAL_DIR=.data/media
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Stripe. Blank → mock billing (test cards, simulated portal) ─────────────
# Test-mode secret key (sk_test_...). Setting it switches checkout/portal to Stripe.
STRIPE_SECRET_KEY=
# Signing secret of your webhook endpoint (or the one `stripe listen` prints).
STRIPE_WEBHOOK_SECRET=
# Not used yet (Stripe-hosted Checkout needs only the secret key).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── AI providers: platform keys. Blank → mock generators ────────────────────
# Keys can also be stored (encrypted) in Admin → AI, which takes precedence.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
HUGGINGFACE_API_TOKEN=
# When real providers are configured but all fail, also try the mock as a last resort.
AI_FALLBACK_TO_MOCK=false
# Simulated latency of the mock generators (ms).
MOCK_AI_DELAY_MS=300
# Generation requests per workspace per minute.
RATE_LIMIT_GENERATIONS_PER_MIN=20
# Concurrent generation jobs per worker process.
AI_WORKER_CONCURRENCY=4
# Optional worker health endpoint (GET / → 200 when running).
WORKER_HEALTH_PORT=

# ── Social publishing apps (Phase 4). Blank → MockPublisher ──────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
