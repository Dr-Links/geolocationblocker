# Copy to a file OUTSIDE public_html, e.g. /home/CPANELUSER/emailplatform.env, then: chmod 600
# Point both Node apps and the cron job at it with ENV_FILE=/home/CPANELUSER/emailplatform.env
# (or place it as .env inside each app folder). Never commit real values.

NODE_ENV=production
PUBLIC_API_URL=https://api.example.com
ADMIN_WEB_URL=https://admin.example.com
TRUST_PROXY=true
MIN_APP_VERSION=0.1.0

# PostgreSQL (cPanel → PostgreSQL Databases). cPanel prefixes names with your account name.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cpaneluser_emailplatform
DB_USER_OWNER=cpaneluser_owner
DB_USER_AUTH=cpaneluser_auth
DB_USER_API=cpaneluser_api
DB_USER_ADMIN=cpaneluser_admin
DB_USER_WORKER=cpaneluser_worker
DB_PASSWORD_OWNER=change-me
DB_PASSWORD_AUTH=change-me
DB_PASSWORD_API=change-me
DB_PASSWORD_ADMIN=change-me
DB_PASSWORD_WORKER=change-me

# Keys: generate with  node dist/cli.js keys:generate  and store each in its own chmod-600 file.
CREDENTIAL_KEY_FILE=/home/cpaneluser/secrets/credential_key
JWT_PRIVATE_KEY_FILE=/home/cpaneluser/secrets/jwt_ed25519.pem

# Account emails (verification, password reset, approval/expiry notices) — a cPanel mailbox works.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASSWORD_FILE=/home/cpaneluser/secrets/smtp_password
SMTP_FROM="Email Platform <no-reply@example.com>"
