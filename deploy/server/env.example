# AllWebMails server settings. Copy to .env and fill in. Secrets go in ./secrets/<name> files (one value per file),
# referenced with *_FILE below — never paste them into chat, issues or email.
NODE_ENV=production
PUBLIC_API_URL=https://app.allwebmails.com
ADMIN_WEB_URL=https://admin.allwebmails.com
TRUST_PROXY=true

# --- Database (hosted PostgreSQL 13+: Supabase, Neon, or your own) ---
DB_HOST=db.example.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_SSL=true
DB_USER_OWNER=awm_owner
DB_USER_AUTH=awm_auth
DB_USER_API=awm_api
DB_USER_ADMIN=awm_admin
DB_USER_WORKER=awm_worker
DB_PASSWORD_OWNER_FILE=/run/secrets/db_password_owner
DB_PASSWORD_AUTH_FILE=/run/secrets/db_password_auth
DB_PASSWORD_API_FILE=/run/secrets/db_password_api
DB_PASSWORD_ADMIN_FILE=/run/secrets/db_password_admin
DB_PASSWORD_WORKER_FILE=/run/secrets/db_password_worker

# --- Keys (create with: docker compose run --rm api node dist/cli.js keys:generate) ---
CREDENTIAL_KEY_FILE=/run/secrets/credential_key
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key.pem
BACKUP_KEY_FILE=/run/secrets/backup_key
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY_FILE=/run/secrets/web_push_private_key
WEB_PUSH_SUBJECT=mailto:admin@allwebmails.com

# --- Account emails (verification, password reset, expiry notices), e.g. a mailbox on your Hostinger plan ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@allwebmails.com
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
SMTP_FROM=AllWebMails <no-reply@allwebmails.com>

# --- Android app updates (APK on allwebmails.com) ---
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
APP_DOWNLOAD_URL=https://allwebmails.com/download/allwebmails.apk

# --- Push for the Android app (Expo push service) ---
PUSH_PROVIDER=expo

# --- Files: on the server's disk by default (/data/blobs); or S3-compatible storage ---
# BLOB_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=allwebmails-files
# S3_ACCESS_KEY_ID_FILE=/run/secrets/s3_access_key_id
# S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_access_key

# --- Backups (node dist/cli.js backup:run, daily) ---
BACKUP_TARGET=local
BACKUP_KEEP=14

# --- Optional virus scanning (docker compose --profile clamav up -d) ---
# CLAMAV_HOST=clamav
